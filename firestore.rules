rules_version = '2';

// Todo el acceso a Firestore pasa por el servidor (firebase-admin, que se salta las reglas).
// Desde el navegador o con la apiKey pública: nada. Pegar en Firebase → Firestore → Reglas.
// Comprobar con: npx tsx scripts/verificar-reglas.ts
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
